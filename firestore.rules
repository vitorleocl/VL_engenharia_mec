rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check master role (or master email)
    function isMaster() {
      return isAuthenticated() && (
        request.auth.token.email == "vitorleonardocl@gmail.com" ||
        request.auth.token.email == "vlengenhariamec@gmail.com" ||
        request.auth.token.email == "atendimento@vlengenhariamecanica.com.br" ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "master")
      );
    }

    // Helper function to check collaborator role
    function isColaborador() {
      return isAuthenticated() && (
        isMaster() ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "colaborador" &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo != false)
      );
    }

    // A permissão específica do módulo é aditiva ao papel existente.
    function hasProjetosGuiaPermission() {
      return isMaster() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "colaborador" &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get("ativo", true) == true &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get("permissoes", {}).get("projetosGuia", false) == true
      );
    }

    // Public contact form submission (Creation allowed without auth, reading/modifying forbidden)
    match /contatos/{contatoId} {
      allow create: if true;
      allow read, update, delete: if isMaster() || isColaborador();
    }

    // Solicitacoes de acesso para aprovação do master
    match /solicitacoesAcesso/{solicitacaoId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isMaster();
    }

    // Healthcheck / connection testing
    match /test/connection {
      allow read: if true;
    }

    // Users and roles collection
    match /usuarios/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isMaster() || isColaborador());
      allow write: if isMaster();
    }

    // Audit logs (strictly read-only for master, writable only through master or backend)
    match /logsAuditoria/{logId} {
      allow read: if isMaster();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // AI usage metrics
    match /usoIA/{anoMes} {
      allow read: if isAuthenticated();
      allow write: if isMaster() || isColaborador();
    }

    // Atomic report counters (LAR-AAAA-NNN)
    match /contadores/{ano} {
      allow read, write: if isColaborador() || isMaster();
    }

    // Clients collection
    match /clientes/{clienteId} {
      allow read, write: if isColaborador() || isMaster();
    }

    // Assets / Equipments
    match /ativos/{ativoId} {
      allow read, write: if isColaborador() || isMaster();
    }

    // Quotes / Budgets
    match /orcamentos/{orcamentoId} {
      allow read, write: if isColaborador() || isMaster();
    }

    // Technical Reports (Laudos)
    match /laudos/{laudoId} {
      allow read, write: if isColaborador() || isMaster();
    }

    // Field Checklists
    match /checklistsCampo/{checklistId} {
      allow read, write: if isColaborador() || isMaster();
    }

    // Report Templates
    match /templatesLaudo/{templateId} {
      allow read, write: if isColaborador() || isMaster();
    }

    // Categorias e Tipos de Laudo (Taxonomia e Diretrizes Técnicas)
    match /categoriasLaudo/{categoriaId} {
      allow read: if true;
      allow write: if isColaborador() || isMaster();

      match /tipos/{tipoId} {
        allow read: if true;
        allow write: if isColaborador() || isMaster();
      }
    }

    // Inspection Schedule / Agenda
    match /agendaVistorias/{agendaId} {
      allow read, write: if isColaborador() || isMaster();
    }

    // Modelos e projetos do Guia Técnico — coleções novas.
    match /guia_modelos/{servico} {
      allow read: if hasProjetosGuiaPermission();
      allow create, update, delete: if isMaster();

      // Arquivos de exemplo do serviço, sem misturá-los com projetos de clientes.
      match /exemplos/{arquivoId} {
        allow read, write: if hasProjetosGuiaPermission();
      }
    }

    match /projetos_guia/{projetoId} {
      allow read, create, update, delete: if hasProjetosGuiaPermission();

      match /{subcolecao}/{documentoId} {
        allow read, create, update, delete: if hasProjetosGuiaPermission();
      }
    }

    // Prospecção comercial — leads e credenciais/configurações restritos ao MASTER.
    match /leads/{leadId} {
      allow read, create, update, delete: if isMaster();
    }

    match /campanhas/{campanhaId} {
      allow read, create, update, delete: if isMaster();
    }

    match /mensagens_modelo/{modeloId} {
      allow read, create, update, delete: if isMaster();
    }

    match /envios/{envioId} {
      allow read, create, update, delete: if isMaster();
    }

    match /supressao/{supressaoId} {
      allow read, update, delete: if isMaster();
      // O endpoint server-side verifica HMAC e limite de requisições antes de gravar.
      allow create: if isMaster();
    }

    match /config_prospeccao/{configId} {
      allow read, create, update, delete: if isMaster();
    }
  }
}
