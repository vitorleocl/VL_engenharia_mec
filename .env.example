# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Monthly limit for Gemini AI diagnostics (defaults to 500)
GEMINI_MONTHLY_LIMIT=500

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Configured in Firebase Console)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Master user email for administrative access
VITE_MASTER_EMAIL="vitorleonardocl@gmail.com"

# Optional server-side Firebase settings (defaults to firebase-applet-config.json).
FIREBASE_WEB_API_KEY=""
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID=""

# Prospecção B2B — somente servidor; nunca prefixar estas variáveis com VITE_
# Credencial Firebase Admin: escolha UMA opção (JSON inline ou GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_SERVICE_ACCOUNT_JSON=""
# GOOGLE_APPLICATION_CREDENTIALS="C:/segredos/firebase-admin.json"
# Domínio do projeto Firestore se não for o default. Use o mesmo databaseId do firebase-applet-config.json.
VITE_FIRESTORE_DATABASE_ID=""

# Segredo aleatório (32+ bytes) para assinar tokens públicos de descadastro.
PROSPECCAO_UNSUBSCRIBE_SECRET=""

# Zoho SMTP (senha de aplicativo Zoho, nunca senha principal)
ZOHO_SMTP_HOST="smtp.zoho.com"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER=""
ZOHO_SMTP_PASS=""
ZOHO_FROM_NAME="VL Engenharia Mecânica"
ZOHO_FROM_EMAIL=""

# Fontes opcionais; a base aberta da Receita deve ser importada por fornecedor/API compatível.
PROSPECCAO_CNPJ_API_URL=""
PROSPECCAO_CNPJ_API_KEY=""
GOOGLE_PLACES_API_KEY=""
PROSPECCAO_DKIM_SELECTORS="zoho,zoho._domainkey"

# O envio fica em dry-run no Firestore até o MASTER desligar explicitamente.
# Valores conservadores; o backend limita o máximo efetivo a 30 e-mails/dia.
