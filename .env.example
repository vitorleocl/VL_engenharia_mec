# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Monthly limit for Gemini AI diagnostics (defaults to 500)
GEMINI_MONTHLY_LIMIT=500

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Configured in Firebase Console)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Master user email for administrative access
VITE_MASTER_EMAIL="vitorleonardocl@gmail.com"

# HVAC service proxy configuration — backend Node/Express only.
# Never prefix HVAC_API_KEY with VITE_ or expose it to the browser.
HVAC_SERVICE_URL="https://your-private-hvac-service.example"
HVAC_API_KEY="replace-with-a-long-random-secret"
HVAC_TIMEOUT_MS=90000

# Optional server-side Firebase settings (defaults to firebase-applet-config.json).
FIREBASE_WEB_API_KEY=""
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID=""
